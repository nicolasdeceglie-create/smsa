# Usato SOLO dalla modalità HTTP (npm run http). Claude Desktop usa il blocco "env" della sua configurazione.
# Copia questo file in .env e compila i valori.

BACKEND_URL=http://localhost:3001
TIMEZONE=Europe/Rome
MCP_HTTP_PORT=3002

# Segreto nell'URL del connettore: chi non lo conosce non può usare i tool.
# Almeno 16 caratteri casuali. Per generarne uno in PowerShell:
#   -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
MCP_SECRET=

# Il vostro dominio statico ngrok (senza https://), es. smsa-demo.ngrok-free.app
NGROK_DOMAIN=
