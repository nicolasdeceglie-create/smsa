# Copia questo file in .env e compila i valori

PORT=3001

# true = usa eventi finti in memoria (nessun bisogno di Google).
# Lasciatelo a true finché i connettori Google/ICS non sono pronti.
MOCK=true

# Fuso orario usato per orari lavorativi e slot liberi
TIMEZONE=Europe/Rome

# Google OAuth (vedi README, ticket B2)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
GOOGLE_CALENDAR_ID=primary

# Calendari ICS in sola lettura (iCloud, ecc.), separati da virgola.
# Formato: Nome|URL   es.  iCloud personale|https://p01-caldav.icloud.com/published/2/...
ICS_FEEDS=
