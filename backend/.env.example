# Copia questo file in .env e compila i valori

PORT=3001

# true = simula Google Calendar e ICS localmente, senza account o rete.
# Gli eventi mock sono in memoria; le scritture non raggiungono servizi esterni.
# false = usa Google Calendar via OAuth e i feed ICS configurati sotto.
MOCK=true

# Facoltativo, solo con MOCK=true: eventi presi dal calendario di esempio del gruppo DB
# invece degli eventi finti. Per avere anche i voti: SEED_FILE in db/ (vedi db/README.md)
# MOCK_DATA_FILE=./example-data/calendario.json

# Fuso orario usato per orari lavorativi e slot liberi
TIMEZONE=Europe/Rome

# Google OAuth (vedi README, ticket B2)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
GOOGLE_CALENDAR_ID=primary

# Calendari ICS in sola lettura (iCloud, ecc.), separati da virgola.
# Formato: Nome|URL   es.  iCloud personale|https://p01-caldav.icloud.com/published/2/...
ICS_FEEDS=
